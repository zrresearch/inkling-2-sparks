# Copy to nodes.conf. Rank 0 is the node you run serve4.sh on.
# Same checkpoint path on every node (the full Inkling-2-Small NVFP4 checkpoint, ~367 GB, on each Spark).
MODEL=/path/to/Inkling-2-Small
# Fabric address of rank 0 (the NCCL / torch.distributed rendezvous).
MASTER=10.0.0.10
# ssh targets for ranks 0-3 ("local" for the head).
NODES=("local" "user@10.0.0.11" "user@10.0.0.12" "user@10.0.0.13")
# RoCE devices per rank (ibdev2netdev). Each Spark's ConnectX-7 shows two; list both to use both halves.
HCAS=("rocep1s0f0,roceP2p1s0f0" "rocep1s0f0,roceP2p1s0f0" "rocep1s0f0,roceP2p1s0f0" "rocep1s0f0,roceP2p1s0f0")
# Network interface on the fabric (same name on every node).
IFNAME=enp1s0f0np0
# RoCE v2 GID index for the fabric address (check with show_gids; it was 5 on our nodes).
GID_INDEX=3
